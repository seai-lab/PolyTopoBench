  "@type": "sc:Dataset",
  "name": "PolyTopoBench Inria Aligned Building Polygons",
  "alternateName": "inria_dataset_aligned",
  "description": "An aligned Inria building dataset used by PolyTopoBench for remote-sensing vector polygon generation. The dataset contains 180 RGB aerial image tiles, aligned binary building raster masks, and GeoJSON polygon annotations. The vector annotations are built by aligning OpenStreetMap building footprints to the Inria Aerial Image Labeling imagery, correcting residual mismatches, and restoring interior rings from the official raster masks.",
  "url": "https://huggingface.co/datasets/NeurIPS2026EDTrack/PolyTopoBench",
  "license": [
    "https://spdx.org/licenses/ODbL-1.0.html",
    "https://project.inria.fr/aerialimagelabeling/"
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "citeAs": "PolyTopoBench: A Benchmark and Unified Evaluation Framework for Complex Vector Polygon Generation from Remote-Sensing Imagery.",
  "version": "1.0.0",
  "datePublished": "2026-05-05",
  "keywords": [
    "remote sensing",
    "aerial imagery",
    "building footprints",
    "polygon generation",
    "GeoJSON",
    "OpenStreetMap",
    "Inria Aerial Image Labeling"
  ],
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "hf-repository",
      "name": "PolyTopoBench Hugging Face dataset repository",
      "description": "The Hugging Face dataset repository containing the released PolyTopoBench data folders.",
      "contentUrl": "https://huggingface.co/datasets/NeurIPS2026EDTrack/PolyTopoBench/tree/main",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "inria-images",
      "name": "Inria RGB aerial image tiles",
      "description": "RGB aerial image tiles from the Inria Aerial Image Labeling data.",
      "containedIn": {
        "@id": "hf-repository"
      },
      "includes": "inria_dataset_aligned/train/images/*.tif",
      "encodingFormat": "image/tiff"
    },
    {
      "@type": "cr:FileSet",
      "@id": "inria-raster-masks",
      "name": "Inria binary building raster masks",
      "description": "Binary raster building masks aligned with the RGB aerial image tiles.",
      "containedIn": {
        "@id": "hf-repository"
      },
      "includes": "inria_dataset_aligned/train/gt/*.tif",
      "encodingFormat": "image/tiff"
    },
    {
      "@type": "cr:FileSet",
      "@id": "inria-vector-polygons",
      "name": "Inria aligned building polygon annotations",
      "description": "GeoJSON GeometryCollection files containing aligned building polygons with exterior and interior rings.",
      "containedIn": {
        "@id": "hf-repository"
      },
      "includes": "inria_dataset_aligned/raw/train/gt_polygonized/*.geojson",
      "encodingFormat": "application/geo+json"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "inria-image-files",
      "name": "Inria image files",
      "description": "One record per RGB aerial image tile.",
      "key": "inria-image-files/tile_id",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "inria-image-files/tile_id",
          "name": "tile_id",
          "description": "Tile identifier extracted from the image file name.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "inria-images"
            },
            "extract": {
              "fileProperty": "filename"
            },
            "transform": {
              "regex": "^(.+)\\.tif$"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inria-image-files/image",
          "name": "image",
          "description": "RGB aerial image tile.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "inria-images"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inria-image-files/class_name",
          "name": "class_name",
          "description": "Semantic object category used by this dataset.",
          "dataType": "sc:Text",
          "value": "building"
        },
        {
          "@type": "cr:Field",
          "@id": "inria-image-files/width",
          "name": "width",
          "description": "Image width in pixels.",
          "dataType": "sc:Integer",
          "value": 5000
        },
        {
          "@type": "cr:Field",
          "@id": "inria-image-files/height",
          "name": "height",
          "description": "Image height in pixels.",
          "dataType": "sc:Integer",
          "value": 5000
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "inria-raster-mask-files",
      "name": "Inria raster mask files",
      "description": "One record per binary building raster mask aligned with an RGB aerial image tile.",
      "key": "inria-raster-mask-files/tile_id",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "inria-raster-mask-files/tile_id",
          "name": "tile_id",
          "description": "Tile identifier extracted from the mask file name.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "inria-raster-masks"
            },
            "extract": {
              "fileProperty": "filename"
            },
            "transform": {
              "regex": "^(.+)\\.tif$"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inria-raster-mask-files/mask",
          "name": "mask",
          "description": "Binary building raster mask.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "inria-raster-masks"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "inria-geojson-files",
      "name": "Inria GeoJSON polygon files",
      "description": "One record per GeoJSON GeometryCollection containing aligned building polygons for an image tile.",
      "key": "inria-geojson-files/tile_id",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "inria-geojson-files/tile_id",
          "name": "tile_id",
          "description": "Tile identifier extracted from the GeoJSON file name.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "inria-vector-polygons"
            },
            "extract": {
              "fileProperty": "filename"
            },
            "transform": {
              "regex": "^(.+)\\.geojson$"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inria-geojson-files/geojson_type",
          "name": "geojson_type",
          "description": "Top-level GeoJSON object type.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "inria-vector-polygons"
            },
            "extract": {
              "jsonPath": "$.type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inria-geojson-files/polygon_types",
          "name": "polygon_types",
          "description": "GeoJSON geometry type for each building polygon.",
          "dataType": "sc:Text",
          "isArray": true,
          "source": {
            "fileSet": {
              "@id": "inria-vector-polygons"
            },
            "extract": {
              "jsonPath": "$.geometries[*].type"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inria-geojson-files/polygon_coordinates",
          "name": "polygon_coordinates",
          "description": "GeoJSON polygon coordinates. The first ring is the exterior ring and later rings, when present, are interior rings.",
          "dataType": "sc:Float",
          "isArray": true,
          "arrayShape": "-1,-1,-1,-1",
          "source": {
            "fileSet": {
              "@id": "inria-vector-polygons"
            },
            "extract": {
              "jsonPath": "$.geometries[*].coordinates"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "inria-geojson-files/class_name",
          "name": "class_name",
          "description": "Semantic object category used by this dataset.",
          "dataType": "sc:Text",
          "value": "building"
        }
      ]
    }
  ]
}
