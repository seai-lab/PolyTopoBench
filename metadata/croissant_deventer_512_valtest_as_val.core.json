  "@type": "sc:Dataset",
  "name": "PolyTopoBench Deventer-512 valtest-as-val",
  "alternateName": "Deventer-512 valtest-as-val",
  "description": "A Deventer-512 split variant used by PolyTopoBench for remote-sensing vector polygon generation. The dataset contains 512 x 512 RGB orthophoto tiles, aligned raster semantic masks, and per-class COCO-style polygon annotations. The validation split combines the upstream Deventer-512 validation and test splits. PolyTopoBench reports the road, vegetation, and unvegetated tasks from this data.",
  "url": "https://huggingface.co/datasets/NeurIPS2026EDTrack/PolyTopoBench",
  "license": "https://spdx.org/licenses/CC-BY-NC-4.0.html",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "citeAs": "PolyTopoBench: A Benchmark and Unified Evaluation Framework for Complex Vector Polygon Generation from Remote-Sensing Imagery.",
  "version": "1.0.0",
  "datePublished": "2026-05-05",
  "keywords": [
    "remote sensing",
    "aerial imagery",
    "polygon generation",
    "polygonal vectorization",
    "land cover",
    "COCO annotations"
  ],
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "hf-repository",
      "name": "PolyTopoBench Hugging Face dataset repository",
      "description": "The Hugging Face dataset repository containing the released PolyTopoBench data folders.",
      "contentUrl": "https://huggingface.co/datasets/NeurIPS2026EDTrack/PolyTopoBench/tree/main",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "deventer-images",
      "name": "Deventer RGB image tiles",
      "description": "RGB orthophoto image tiles for the train and val splits.",
      "containedIn": {
        "@id": "hf-repository"
      },
      "includes": "deventer_512_valtest_as_val/*/images/*.png",
      "encodingFormat": "image/png"
    },
    {
      "@type": "cr:FileSet",
      "@id": "deventer-masks",
      "name": "Deventer raster semantic masks",
      "description": "Raster semantic masks aligned with the RGB image tiles.",
      "containedIn": {
        "@id": "hf-repository"
      },
      "includes": "deventer_512_valtest_as_val/*/masks/*.png",
      "encodingFormat": "image/png"
    },
    {
      "@type": "cr:FileSet",
      "@id": "deventer-coco-annotations",
      "name": "Deventer per-class COCO-style polygon annotations",
      "description": "Per-class COCO-style JSON annotation files for building, road, vegetation, water, and unvegetated regions.",
      "containedIn": {
        "@id": "hf-repository"
      },
      "includes": "deventer_512_valtest_as_val/*/annotations/*.json",
      "encodingFormat": "application/json"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "deventer-image-files",
      "name": "Deventer image files",
      "description": "One record per RGB orthophoto tile.",
      "key": "deventer-image-files/file_name",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "deventer-image-files/file_name",
          "name": "file_name",
          "description": "Image tile file name.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "deventer-images"
            },
            "extract": {
              "fileProperty": "filename"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-image-files/split",
          "name": "split",
          "description": "Split name extracted from the image path.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "deventer-images"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "deventer_512_valtest_as_val/(train|val)/images/.*\\.png$"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-image-files/image",
          "name": "image",
          "description": "RGB orthophoto tile.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "deventer-images"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-image-files/width",
          "name": "width",
          "description": "Image width in pixels.",
          "dataType": "sc:Integer",
          "value": 512
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-image-files/height",
          "name": "height",
          "description": "Image height in pixels.",
          "dataType": "sc:Integer",
          "value": 512
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "deventer-mask-files",
      "name": "Deventer mask files",
      "description": "One record per raster semantic mask aligned with an RGB image tile.",
      "key": "deventer-mask-files/file_name",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "deventer-mask-files/file_name",
          "name": "file_name",
          "description": "Mask file name.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "deventer-masks"
            },
            "extract": {
              "fileProperty": "filename"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-mask-files/split",
          "name": "split",
          "description": "Split name extracted from the mask path.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "deventer-masks"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "deventer_512_valtest_as_val/(train|val)/masks/.*\\.png$"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-mask-files/mask",
          "name": "mask",
          "description": "Raster semantic mask aligned with the RGB tile of the same file name.",
          "dataType": "sc:ImageObject",
          "source": {
            "fileSet": {
              "@id": "deventer-masks"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "deventer-coco-annotation-files",
      "name": "Deventer COCO annotation files",
      "description": "One record per per-class COCO-style annotation file.",
      "key": "deventer-coco-annotation-files/file_name",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "deventer-coco-annotation-files/file_name",
          "name": "file_name",
          "description": "COCO annotation JSON file name.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "deventer-coco-annotations"
            },
            "extract": {
              "fileProperty": "filename"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-coco-annotation-files/split",
          "name": "split",
          "description": "Split name extracted from the annotation path.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "deventer-coco-annotations"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "deventer_512_valtest_as_val/(train|val)/annotations/.*\\.json$"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-coco-annotation-files/class_name",
          "name": "class_name",
          "description": "Semantic class name extracted from the annotation file name.",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "deventer-coco-annotations"
            },
            "extract": {
              "fileProperty": "filename"
            },
            "transform": {
              "regex": "^(building|road|vegetation|water|unvegetated)\\.json$"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-coco-annotation-files/images",
          "name": "images",
          "description": "COCO images array containing image id, file name, width, and height.",
          "dataType": "sc:Text",
          "isArray": true,
          "source": {
            "fileSet": {
              "@id": "deventer-coco-annotations"
            },
            "extract": {
              "jsonPath": "$.images[*]"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-coco-annotation-files/annotations",
          "name": "annotations",
          "description": "COCO annotations array containing polygon segmentations, bounding boxes, areas, category ids, and image ids.",
          "dataType": "sc:Text",
          "isArray": true,
          "source": {
            "fileSet": {
              "@id": "deventer-coco-annotations"
            },
            "extract": {
              "jsonPath": "$.annotations[*]"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "deventer-coco-annotation-files/categories",
          "name": "categories",
          "description": "COCO categories array for the annotation file.",
          "dataType": "sc:Text",
          "isArray": true,
          "source": {
            "fileSet": {
              "@id": "deventer-coco-annotations"
            },
            "extract": {
              "jsonPath": "$.categories[*]"
            }
          }
        }
      ]
    }
  ]
}
